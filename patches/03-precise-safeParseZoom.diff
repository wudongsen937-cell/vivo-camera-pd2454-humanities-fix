     return p0
 .end method
+
+# 移植包把镜头标签（Wide / SAT / Tele3P5x）塞进了 CameraTypeZoomPoint.zoom，
+# 直接 parseFloat 会抛 NumberFormatException。这里收敛成一次安全解析：
+# 数值照常走原逻辑，标签按 ZoomCompat 的真实倍率映射，未知值退回 1.0f。
+.method public static safeParseZoom(Ljava/lang/String;)F
+    .locals 3
+
+    const/high16 v0, 0x3f800000    # 1.0f
+
+    if-nez p0, :done
+
+    :try_start
+    invoke-static {p0}, Ljava/lang/Float;->parseFloat(Ljava/lang/String;)F
+
+    move-result v1
+
+    return v1
+    :try_end
+    .catch Ljava/lang/NumberFormatException; {:try_start .. :try_end} :label_wide
+
+    :label_wide
+    const-string v1, "Wide"
+
+    invoke-virtual {p0, v1}, Ljava/lang/String;->equalsIgnoreCase(Ljava/lang/String;)Z
+
+    move-result v1
+
+    if-eqz v1, :label_sat
+
+    const v0, 0x3f266666    # 0.65f
+
+    return v0
+
+    :label_sat
+    const-string v1, "SAT"
+
+    invoke-virtual {p0, v1}, Ljava/lang/String;->equalsIgnoreCase(Ljava/lang/String;)Z
+
+    move-result v1
+
+    if-eqz v1, :label_tele3
+
+    const v0, 0x3f266666    # 0.65f
+
+    return v0
+
+    :label_tele3
+    const-string v1, "Tele3P5x"
+
+    invoke-virtual {p0, v1}, Ljava/lang/String;->equalsIgnoreCase(Ljava/lang/String;)Z
+
+    move-result v1
+
+    if-eqz v1, :label_tele
+
+    const v0, 0x406ccccd    # 3.7f
+
+    return v0
+
+    :label_tele
+    const-string v1, "Tele"
+
+    invoke-virtual {p0, v1}, Ljava/lang/String;->equalsIgnoreCase(Ljava/lang/String;)Z
+
+    move-result v1
+
+    if-eqz v1, :done
+
+    const v0, 0x406ccccd    # 3.7f
+
+    :done
+    return v0
+.end method
